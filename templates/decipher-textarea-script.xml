<script>
window.CursorTrace = (function() {
  var THROTTLE_MS = 50;
  var fieldData = {};
  function attach(fieldId, el) {
    var id = String(fieldId);
    fieldData[id] = { events: [] };
    var startTime = null;
    var lastX = null;
    var lastY = null;
    var lastMoveTime = -Infinity;
    function initTime() { if (startTime === null) startTime = performance.now(); }
    function ts() { return startTime !== null ? Math.round(performance.now() - startTime) : 0; }
    el.addEventListener('mouseenter', function(e) {
      initTime(); lastX = e.clientX; lastY = e.clientY;
      fieldData[id].events.push({ t: ts(), type: 'e' });
    }, { passive: true });
    el.addEventListener('mouseleave', function() {
      initTime(); fieldData[id].events.push({ t: ts(), type: 'l' });
    }, { passive: true });
    el.addEventListener('mousemove', function(e) {
      var now = performance.now();
      if (now - lastMoveTime < THROTTLE_MS) return;
      lastMoveTime = now; initTime();
      var dx = lastX !== null ? Math.round(e.clientX - lastX) : 0;
      var dy = lastY !== null ? Math.round(e.clientY - lastY) : 0;
      lastX = e.clientX; lastY = e.clientY;
      fieldData[id].events.push({ t: ts(), type: 'm', dx: dx, dy: dy });
    }, { passive: true });
    el.addEventListener('click', function() {
      initTime(); fieldData[id].events.push({ t: ts(), type: 'c' });
    }, { passive: true });
  }
  function getPayload() { return JSON.parse(JSON.stringify(fieldData)); }
  function reset() { Object.keys(fieldData).forEach(function(k) { delete fieldData[k]; }); }
  return { attach: attach, getPayload: getPayload, reset: reset };
}());

(function() {
  var allInputs = document.querySelectorAll('input[type="text"]');
  if (allInputs.length) {
    allInputs[allInputs.length - 1].setAttribute('data-ct-store', '1');
  }

  function attachAll() {
    var hidden = document.querySelector('[data-ct-store="1"]');
    if (!hidden) { console.warn('[alias-ct] WARNING: hidden field not found'); return; }

    function syncToHidden() {
      var payload = JSON.stringify(window.CursorTrace.getPayload());
      hidden.value = payload;
      try { hidden.dispatchEvent(new Event('input', { bubbles: true })); } catch(_) {}
      try { hidden.dispatchEvent(new Event('change', { bubbles: true })); } catch(_) {}
      console.log('[alias-ct] syncToHidden: wrote', payload.length, 'chars');
    }

    document.querySelectorAll('textarea').forEach(function(el, idx) {
      window.CursorTrace.attach(idx, el);
    });
    console.log('[alias-ct] attached to', document.querySelectorAll('textarea').length, 'textareas');
    var form = document.querySelector('form');
    if (form) {
      form.addEventListener('submit', function() {
        try { syncToHidden(); } catch(e) { console.error('[alias-ct] submit sync error:', e); }
      }, { capture: true });
    }
    // Also sync on mouse leave from any textarea (in case user doesn't interact again before submit)
    document.querySelectorAll('textarea').forEach(function(el) {
      el.addEventListener('mouseleave', syncToHidden, { passive: true });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', attachAll);
  } else {
    attachAll();
  }
})();
</script>
]]></style>
