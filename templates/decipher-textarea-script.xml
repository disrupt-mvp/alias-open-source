<script>
window.KeystrokeTracker = (function() {
  const fieldData = {};
  function attach(fieldId, el, onEvent) {
    const id = String(fieldId);
    fieldData[id] = { events: [] };
    let startTime = null;
    function ts() {
      return startTime !== null ? Math.round(performance.now() - startTime) : 0;
    }
    el.addEventListener('focus', () => {
      if (startTime === null) {
        startTime = performance.now();
        fieldData[id].events.push({ t: 0, type: 'f', val: null });
      } else {
        fieldData[id].events.push({ t: ts(), type: 'f', val: null });
      }
      if (onEvent) onEvent();
    }, { passive: true });
    el.addEventListener('blur', () => {
      fieldData[id].events.push({ t: ts(), type: 'b', val: null });
      if (onEvent) onEvent();
    }, { passive: true });
    el.addEventListener('keydown', (e) => {
      fieldData[id].events.push({ t: ts(), type: 'k', val: e.key });
      if (onEvent) onEvent();
    }, { passive: true });
    el.addEventListener('paste', (e) => {
      var len = 0;
      try {
        var text = (e.clipboardData || window.clipboardData).getData('text');
        len = text ? text.length : 0;
      } catch (_) {}
      fieldData[id].events.push({ t: ts(), type: 'p', val: len });
      if (onEvent) onEvent();
    }, { passive: true });
    el.addEventListener('copy', () => {
      var len = 0;
      try {
        var sel = window.getSelection();
        len = sel ? sel.toString().length : 0;
      } catch (_) {}
      fieldData[id].events.push({ t: ts(), type: 'c', val: len });
      if (onEvent) onEvent();
    }, { passive: true });
  }
  function getPayload() { return JSON.parse(JSON.stringify(fieldData)); }
  function reset() { Object.keys(fieldData).forEach(function(k) { delete fieldData[k]; }); }
  return { attach: attach, getPayload: getPayload, reset: reset };
}());
</script>
]]></style>
