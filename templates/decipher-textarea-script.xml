<!-- ======================================================
     Face analysis store — captures per-question emotion
     summaries from the FaceTracker. Only active when
     FACE_ANALYSIS_ENABLED = true. Toggle safely with no
     impact on existing data when set to false (default).
     ====================================================== -->
<text
  label="alias_face_store"
  size="9999"
  length="20000"
  where="execute,survey,report">
  <title>face analysis payload</title>
  <row label="r1">face-data</row>
  <style name="question.after"><![CDATA[
<script>
// ── Face Analysis Toggle ───────────────────────────────────────────────────────
// Set to true to enable camera-based emotion analysis for this survey.
// When false: no camera prompt, no frames sent, no face_data in API payload.
var FACE_ANALYSIS_ENABLED = false;

// ── Configuration ─────────────────────────────────────────────────────────────
var FACE_FRAME_ENDPOINT = 'https://open-qa.onrender.com/v1/face-frame';
var FACE_FRAME_AUTH = '6e6fee6f536cf8a907b52c7d897e9a55';
var FACE_CAPTURE_INTERVAL_MS = 4000; // capture one frame every 4 seconds per focused field

// ── FaceTracker ───────────────────────────────────────────────────────────────
(function() {
  if (!FACE_ANALYSIS_ENABLED) return;

  // Mark the hidden face store field so we can find it
  var allInputs = document.querySelectorAll('input[type="text"]');
  if (allInputs.length) {
    allInputs[allInputs.length - 1].setAttribute('data-face-store', '1');
  }

  // Per-question accumulated face data
  // { "0": { samples, dominant, distribution, engagement, looking_away_count, others_present_count } }
  var faceData = {};
  var currentFieldIdx = null;
  var captureTimer = null;
  var videoStream = null;
  var videoEl = null;
  var canvasEl = null;

  function initCamera(onReady) {
    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
      console.warn('[alias-face] getUserMedia not supported');
      return;
    }
    navigator.mediaDevices.getUserMedia({ video: { width: 320, height: 240, facingMode: 'user' } })
      .then(function(stream) {
        videoStream = stream;
        videoEl = document.createElement('video');
        videoEl.style.cssText = 'position:fixed;top:-9999px;left:-9999px;width:320px;height:240px;';
        videoEl.srcObject = stream;
        videoEl.autoplay = true;
        videoEl.playsInline = true;
        videoEl.muted = true;
        document.body.appendChild(videoEl);
        canvasEl = document.createElement('canvas');
        canvasEl.width = 320;
        canvasEl.height = 240;
        videoEl.addEventListener('loadedmetadata', function() {
          console.log('[alias-face] camera ready');
          if (onReady) onReady();
        });
      })
      .catch(function(err) {
        console.warn('[alias-face] camera permission denied or unavailable:', err.message);
      });
  }

  function captureFrame() {
    if (!videoEl || !canvasEl || !videoStream || currentFieldIdx === null) return;
    try {
      var ctx = canvasEl.getContext('2d');
      ctx.drawImage(videoEl, 0, 0, 320, 240);
      var dataUrl = canvasEl.toDataURL('image/jpeg', 0.7);
      var frameB64 = dataUrl.split(',')[1];
      if (frameB64) sendFrame(frameB64, currentFieldIdx);
    } catch(e) {
      console.warn('[alias-face] capture error:', e.message);
    }
  }

  function sendFrame(frameB64, fieldIdx) {
    console.log('[alias-face] sending frame field=' + fieldIdx + ' b64len=' + frameB64.length + ' to ' + FACE_FRAME_ENDPOINT);
    try {
      var xhr = new XMLHttpRequest();
      xhr.open('POST', FACE_FRAME_ENDPOINT, true);
      xhr.setRequestHeader('Content-Type', 'application/json');
      xhr.setRequestHeader('Authorization', 'Bearer ' + FACE_FRAME_AUTH);
      xhr.onload = function() {
        console.log('[alias-face] xhr.onload status=' + xhr.status + ' response=' + xhr.responseText.slice(0, 100));
        if (xhr.status === 200) {
          try {
            var result = JSON.parse(xhr.responseText);
            accumulateFaceData(fieldIdx, result);
          } catch(e) { console.warn('[alias-face] parse error:', e.message); }
        } else {
          console.warn('[alias-face] server error status=' + xhr.status + ' body=' + xhr.responseText.slice(0, 200));
        }
      };
      xhr.onerror = function() { console.warn('[alias-face] frame send failed — likely CORS or network error. Check DevTools Network tab.'); };
      xhr.send(JSON.stringify({ session_id: 'decipher_' + performance.now(), question_idx: fieldIdx, frame_b64: frameB64 }));
    } catch(e) {
      console.warn('[alias-face] sendFrame error:', e.message);
    }
  }

  function accumulateFaceData(fieldIdx, result) {
    var key = String(fieldIdx);
    if (!faceData[key]) {
      faceData[key] = { samples: 0, dominant: null, distribution: {}, engagement: 0, looking_away_count: 0, others_present_count: 0 };
    }
    var entry = faceData[key];
    entry.samples++;
    var emotion = result.emotion || 'unknown';
    entry.distribution[emotion] = (entry.distribution[emotion] || 0) + 1;
    var maxCount = 0;
    Object.keys(entry.distribution).forEach(function(em) {
      if (entry.distribution[em] > maxCount) { maxCount = entry.distribution[em]; entry.dominant = em; }
    });
    if (!result.looking_at_screen) entry.looking_away_count++;
    if (result.others_present) entry.others_present_count++;
    var engScore = typeof result.engagement_score === 'number' ? result.engagement_score : 5;
    entry.engagement = ((entry.engagement * (entry.samples - 1)) + engScore) / entry.samples;
    syncToHidden();
    console.log('[alias-face] sample recorded field=' + key + ' emotion=' + emotion + ' engagement=' + engScore);
  }

  function startCapture(fieldIdx) {
    currentFieldIdx = fieldIdx;
    stopCapture();
    captureFrame();
    captureTimer = setInterval(captureFrame, FACE_CAPTURE_INTERVAL_MS);
  }

  function stopCapture() {
    if (captureTimer) { clearInterval(captureTimer); captureTimer = null; }
  }

  function stopCamera() {
    stopCapture();
    if (videoStream) {
      videoStream.getTracks().forEach(function(t) { t.stop(); });
      videoStream = null;
    }
    if (videoEl && videoEl.parentNode) { videoEl.parentNode.removeChild(videoEl); videoEl = null; }
  }

  function syncToHidden() {
    var hidden = document.querySelector('[data-face-store="1"]');
    if (hidden) {
      var payload = JSON.stringify(faceData);
      hidden.value = payload;
      try { hidden.dispatchEvent(new Event('input', { bubbles: true })); } catch(_) {}
      try { hidden.dispatchEvent(new Event('change', { bubbles: true })); } catch(_) {}
      console.log('[alias-face] syncToHidden: wrote', payload.length, 'chars');
    }
  }

  function attachAll() {
    var hidden = document.querySelector('[data-face-store="1"]');
    if (!hidden) { console.warn('[alias-face] face store field not found'); return; }
    initCamera(function() {
      document.querySelectorAll('textarea').forEach(function(el, idx) {
        el.addEventListener('focus', function() { startCapture(idx); });
        el.addEventListener('blur', function() { stopCapture(); currentFieldIdx = null; });
      });
      console.log('[alias-face] attached to', document.querySelectorAll('textarea').length, 'textareas');
      var form = document.querySelector('form');
      if (form) {
        form.addEventListener('submit', function() {
          try { syncToHidden(); stopCamera(); } catch(e) { console.error('[alias-face] submit error:', e); }
        }, { capture: true });
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', attachAll);
  } else {
    attachAll();
  }
})();
</script>
]]></style>
</text>

